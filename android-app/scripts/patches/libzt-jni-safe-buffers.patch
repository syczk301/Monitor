@@ -27,8 +27,55 @@
 #include "lwip/stats.h"
 
 #include <jni.h>
+#include <cerrno>
+#include <memory>
+#include <new>
 
 extern int zts_errno;
+
+// lwIP also updates the Android thread-local errno. zts_errno is global and
+// another socket can overwrite it between the operation and JNI's return.
+static int socket_result(int retval, int native_errno)
+{
+    if (retval >= 0 || retval < ZTS_ERR_SOCKET) return retval;
+    return native_errno != 0 ? -native_errno : ZTS_ERR_SOCKET;
+}
+
+
+// Never pin a Java heap array while blocking in the network stack. Idle
+// keep-alive reads can otherwise hold a JNI critical region indefinitely.
+static bool checked_array_range(JNIEnv* env, jbyteArray buf, jint offset, jint len)
+{
+    if (buf == nullptr) {
+        env->ThrowNew(env->FindClass("java/lang/NullPointerException"), "buffer");
+        return false;
+    }
+    const jsize size = env->GetArrayLength(buf);
+    if (offset < 0 || len < 0 || offset > size || len > size - offset) {
+        env->ThrowNew(env->FindClass("java/lang/IndexOutOfBoundsException"), "buffer range");
+        return false;
+    }
+    return !env->ExceptionCheck();
+}
+
+static std::unique_ptr<jbyte[]> socket_buffer(JNIEnv* env, jint len)
+{
+    std::unique_ptr<jbyte[]> data(new (std::nothrow) jbyte[len > 0 ? len : 1]);
+    if (!data) {
+        env->ThrowNew(env->FindClass("java/lang/OutOfMemoryError"), "native socket buffer");
+    }
+    return data;
+}
+
+static jint array_length(JNIEnv* env, jbyteArray buf)
+{
+    if (buf == nullptr) {
+        env->ThrowNew(env->FindClass("java/lang/NullPointerException"), "buffer");
+        return -1;
+    }
+    return env->GetArrayLength(buf);
+}
