USE_MONGODB_STORAGE=true
USE_MONGODB_IDENTITY_TEMPLATES=true
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?appName=Monitor"
MONGODB_DATABASE="camera_monitor"
MONGODB_IDENTITY_COLLECTION="identity_templates"
CAMERA_WIDTH=3840
CAMERA_HEIGHT=2160
PIPELINE_RUN_WITHOUT_CLIENTS=false
LOCAL_RECORDING_ENABLED=true
LOCAL_RECORDING_OUTPUT_DIR="D:\download\Monitor"
LOCAL_RECORDING_RETENTION_DAYS=30
LOCAL_RECORDING_SEGMENT_MINUTES=60
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BLOCK_FRAMES=2048

# Local reverse proxy auth for Tailscale/Caddy setup.
# Generate the hash with:
#   caddy hash-password --plaintext "your-password"
CADDY_BASIC_AUTH_USER="monitor_admin"
CADDY_BASIC_AUTH_HASH="$2a$14$replace_with_caddy_hash"
