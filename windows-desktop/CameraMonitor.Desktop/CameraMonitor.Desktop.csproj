<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CameraMonitor.Desktop</AssemblyName>
    <RootNamespace>CameraMonitor.Desktop</RootNamespace>
    <ApplicationIcon>..\..\assets\tray_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\assets\tray_icon.ico" Link="assets\tray_icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
